#include <SPI.h>
#include <LoRa.h>
#include "BluetoothSerial.h"
// #include <WiFi.h>
//define the pins used by the transceiver module
#define ss 4
#define rst 14
#define dio0 2

String LoRaData=" ";
String rssi=" ";
byte counter = 0;

uint64_t chipId = ESP.getEfuseMac(); // Retrieves the MAC address (48 bits)
uint32_t uniqueId = (uint32_t)(chipId >> 24); // Extracts the upper 24 bits as a unique ID


#define USE_PIN            // Uncomment this to use PIN during pairing. The pin is specified on the line below
const char *pin = "1234";  // Change this to more secure PIN.

String device_name = "ESP32-BT-Slave_TX";

#if !defined(CONFIG_BT_ENABLED) || !defined(CONFIG_BLUEDROID_ENABLED)
#error Bluetooth is not enabled! Please run `make menuconfig` to and enable it
#endif

#if !defined(CONFIG_BT_SPP_ENABLED)
#error Serial Bluetooth not available or not enabled. It is only available for the ESP32 chip.
#endif

BluetoothSerial SerialBT;

void setup() {
    Serial.begin(115200);
    SerialBT.begin(device_name); //Bluetooth device name
    Serial.printf("The device with name \"%s\" is started.\nNow you can pair it with Bluetooth!\n", device_name.c_str());
  //Serial.printf("The device with name \"%s\" and MAC address %s is started.\nNow you can pair it with Bluetooth!\n", device_name.c_str(), SerialBT.getMacString()); // Use this after the MAC method is implemented
    // #ifdef USE_PIN
    //   SerialBT.setPin(pin);
    //   Serial.println("Using PIN");
    // #endif


  //initialize Serial Monitor
  Serial.begin(115200);
  while (!Serial);
  Serial.println("LoRa Sender");

  //setup LoRa transceiver module
  LoRa.setPins(ss, rst, dio0);
  
  //replace the LoRa.begin(---E-) argument with your location's frequency 
  //433E6 for Asia
  //866E6 for Europe
  //915E6 for North America
  // 866 MHz to 867 MHZ is licensed in India
  while (!LoRa.begin(866E6)) {
    Serial.println(".");
    delay(1000);
  }
   // Change sync word (0x01) to match the receiver
  // The sync word assures you don't get LoRa messages from other LoRa transceivers
 // ranges from 0-0xFF
  LoRa.setSyncWord(0xF1);
  Serial.println("LoRa Initializing OK!");
}

void loop() {

  Serial.print("Sending packet: ");
  Serial.println(uniqueId);

  //Send LoRa packet to receiver
  LoRa.idle();
  LoRa.beginPacket();
  LoRa.print(F("hello "));
  LoRa.print(uniqueId);
  LoRa.endPacket();
  LoRa.sleep();
  
  char str[20]; // Make sure this is large enough to hold your integer as a string
  itoa(counter, str, 10);

  char id[20];
  itoa(uniqueId, id, 10);

  // Construct the complete message for Bluetooth
  String LoRaData = "Sending packet via LoRa: '";
  LoRaData += str; // Concatenate the counter as a string
  LoRaData += ", ID: ";
  LoRaData += id;
  String message1 = "', Mode: TX ";
  String message2 = "\n";
  Serial.println(LoRaData);
  // Send data via Bluetooth
  SerialBT.write((const uint8_t*)message2.c_str(), message2.length());
  SerialBT.write((const uint8_t*)LoRaData.c_str(), LoRaData.length());
  SerialBT.write((const uint8_t*)message1.c_str(), message1.length());


  counter++;

  delay(1000);
}
